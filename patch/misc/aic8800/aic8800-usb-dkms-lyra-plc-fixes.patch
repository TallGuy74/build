--- /dev/null
+++ b/USB/driver_fw/drivers/aic8800/aic8800_fdrv/aic_init_fs.h
@@ -0,0 +1,27 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Linux 7.x roots kernel threads (the USB hub worker that probes a re-enumerated device, workqueues) in an empty
+ * nullfs; path lookups from them must run under scoped_with_init_fs() to see the userspace root. This driver opens
+ * its firmware and calibration files with filp_open(), which therefore failed with -ENOENT whenever the device was
+ * probed from the hub worker (power cycle, USB reset, reset-resume) instead of from modprobe. Route every
+ * filp_open() through the init fs where the kernel has it; older kernels are unchanged.
+ */
+#ifndef AIC_INIT_FS_H
+#define AIC_INIT_FS_H
+
+#include <linux/fs.h>
+#include <linux/fs_struct.h>
+
+#ifdef scoped_with_init_fs
+static inline struct file *aic_filp_open(const char *path, int flags, umode_t mode)
+{
+	struct file *fp;
+
+	scoped_with_init_fs()
+		fp = filp_open(path, flags, mode);
+	return fp;
+}
+#define filp_open(path, flags, mode) aic_filp_open(path, flags, mode)
+#endif
+
+#endif /* AIC_INIT_FS_H */
