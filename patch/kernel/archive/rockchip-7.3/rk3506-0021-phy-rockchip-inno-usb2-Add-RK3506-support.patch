From 0fa21ec401e21b632200b572fe5080f8c09ec936 Mon Sep 17 00:00:00 2001
From: Bas Vermeulen <bas.vermeulen@blackstar.nl>
Date: Wed, 28 Oct 2026 16:49:55 +0100
Subject: [PATCH 21/70] phy: rockchip: inno-usb2: Add RK3506 support

The RK3506 USB2 PHY has two ports, OTG0 and OTG1, each with the full
OTG detection register set in the USB GRF (OTG0 at 0x60/0x150, OTG1 at
0x70/0x170, UTMI status at 0x118). The vendor tuning is carried over
through the PHY's own register map: differential receivers off in
suspend, HS eye height 425 mV, and the TX driver's fs/ls data chosen as
linestate for both ports.

Signed-off-by: Bas Vermeulen <bas.vermeulen@blackstar.nl>

diff --git a/drivers/phy/rockchip/phy-rockchip-inno-usb2.c b/drivers/phy/rockchip/phy-rockchip-inno-usb2.c
index 7d8a533f2..1f8ce2efa 100644
--- a/drivers/phy/rockchip/phy-rockchip-inno-usb2.c
+++ b/drivers/phy/rockchip/phy-rockchip-inno-usb2.c
@@ -1512,6 +1512,33 @@ static int rk3128_usb2phy_tuning(struct rockchip_usb2phy *rphy)
 				BIT(2) << BIT_WRITEABLE_SHIFT | 0);
 }
 
+static int rk3506_usb2phy_tuning(struct rockchip_usb2phy *rphy)
+{
+	int ret;
+
+	/* Turn off the otg0/otg1 port differential receivers in suspend mode */
+	ret = regmap_write(rphy->phy_base, 0x30, BIT(18) | 0x0000);
+	if (ret)
+		return ret;
+	ret = regmap_write(rphy->phy_base, 0x430, BIT(18) | 0x0000);
+	if (ret)
+		return ret;
+
+	/* Set the otg0/otg1 port HS eye height to 425mv (default is 450mv) */
+	ret = regmap_write(rphy->phy_base, 0x30, GENMASK(22, 20) | (0x05 << 4));
+	if (ret)
+		return ret;
+	ret = regmap_write(rphy->phy_base, 0x430, GENMASK(22, 20) | (0x05 << 4));
+	if (ret)
+		return ret;
+
+	/* Choose the Tx fs/ls data as linestate from the TX driver for both ports */
+	ret = regmap_write(rphy->phy_base, 0x94, GENMASK(22, 19) | (0x03 << 3));
+	if (ret)
+		return ret;
+	return regmap_write(rphy->phy_base, 0x494, GENMASK(22, 19) | (0x03 << 3));
+}
+
 static int rk3528_usb2phy_tuning(struct rockchip_usb2phy *rphy)
 {
 	int ret;
