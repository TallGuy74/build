From 691cc2dfe7ac208806d371b2161671d4cab90638 Mon Sep 17 00:00:00 2001
From: Bas Vermeulen <bas.vermeulen@blackstar.nl>
Date: Thu, 29 Oct 2026 22:37:28 +0100
Subject: [PATCH 73/74] ARM: dts: rockchip: rk3506b-luckfox-lyra-plc: Drive the
 LCD with panel-mipi-dbi

Describe the LCD for the generic MIPI DBI panel driver instead of the
staging fbtft one. The init sequence, including the landscape address
mode, comes from the firmware file luckfox,lyra-plc-lcd.bin; the device
tree gives the resulting 320x170 mode, with the visible rows starting
at row 35 of the controller's RAM, and the size derived from the 1.9"
diagonal. The node no longer needs the fbtft-only properties the panel
schemas do not know.

The reset line is active low, but mipi_dbi sets the reset GPIO to 1 for
"running", as the other tiny DRM panels expect, so it is described as
active high; described as active low it holds the controller in reset.

The DRM driver also switches the backlight with the display, which
fbtft does not do for a PWM backlight.

Switch the PLC config fragment over and defer the framebuffer console
takeover, so a quiet boot leaves the panel alone until text is printed
instead of showing a cursor before the splash.

Signed-off-by: Bas Vermeulen <bas.vermeulen@blackstar.nl>

diff --git a/arch/arm/boot/dts/rockchip/rk3506b-luckfox-lyra-plc.dts b/arch/arm/boot/dts/rockchip/rk3506b-luckfox-lyra-plc.dts
index 4644a26a1..9bedd49bd 100644
--- a/arch/arm/boot/dts/rockchip/rk3506b-luckfox-lyra-plc.dts
+++ b/arch/arm/boot/dts/rockchip/rk3506b-luckfox-lyra-plc.dts
@@ -278,29 +278,41 @@ &sdmmc {
 	status = "okay";
 };
 
-/* 1.9" 170x320 ST7789V panel, fbtft */
+/* 1.9" 170x320 ST7789V panel, mounted landscape */
 &spi0 {
 	pinctrl-names = "default";
 	pinctrl-0 = <&rm_io1_spi0_clk>, <&rm_io4_spi0_mosi>, <&rm_io3_spi0_csn0>;
 	status = "okay";
 
 	display@0 {
-		compatible = "sitronix,st7789v";
+		compatible = "luckfox,lyra-plc-lcd", "panel-mipi-dbi-spi";
 		reg = <0>;
 		spi-max-frequency = <50000000>;
+		dc-gpios = <&gpio0 RK_PA2 GPIO_ACTIVE_HIGH>;
+		/* the reset is active low, but mipi_dbi drives the line as "running" */
+		reset-gpios = <&gpio0 RK_PA0 GPIO_ACTIVE_HIGH>;
+		write-only;
 		power-supply = <&vcc_3v3>;
 		backlight = <&backlight>;
-		/* fbtft (staging) properties; the sitronix,st7789v panel schema does not know them */
-		buswidth = <8>;
-		fps = <60>;
-		/* 1.9" 170x320 glass at columns 35..204 of the controller's 240x320 RAM */
-		width = <170>;
-		height = <320>;
-		col-offset = <35>;
-		/* 170x320 glass mounted landscape: rotate the framebuffer (degrees) */
-		rotate = <270>;
-		dc-gpios = <&gpio0 RK_PA2 GPIO_ACTIVE_HIGH>;
-		reset-gpios = <&gpio0 RK_PA0 GPIO_ACTIVE_LOW>;
+		width-mm = <43>;
+		height-mm = <23>;
+
+		/*
+		 * The init sequence in the firmware file sets the address mode
+		 * to landscape (MV | MX), where the 170 visible rows start at
+		 * row 35 of the controller's 240x320 RAM.
+		 */
+		panel-timing {
+			hactive = <320>;
+			vactive = <170>;
+			hback-porch = <0>;
+			vback-porch = <35>;
+			clock-frequency = <0>;
+			hfront-porch = <0>;
+			hsync-len = <0>;
+			vfront-porch = <0>;
+			vsync-len = <0>;
+		};
 	};
 };
 
diff --git a/arch/arm/configs/rk3506_plc.config b/arch/arm/configs/rk3506_plc.config
index 24a4e52ed..d2760d263 100644
--- a/arch/arm/configs/rk3506_plc.config
+++ b/arch/arm/configs/rk3506_plc.config
@@ -23,13 +23,17 @@ CONFIG_STMMAC_ETH=y
 CONFIG_DWMAC_ROCKCHIP=y
 CONFIG_PHYLIB=y
 
-# 1.9" ST7789V panel through fbtft, console on it
+# 1.9" ST7789V panel through panel-mipi-dbi (init sequence from
+# /lib/firmware/luckfox,lyra-plc-lcd.bin), console on it once text is printed
+CONFIG_DRM=y
+CONFIG_DRM_FBDEV_EMULATION=y
+CONFIG_DRM_PANEL_MIPI_DBI=m
 CONFIG_FB=y
-CONFIG_FB_TFT=y
-CONFIG_FB_TFT_ST7789V=y
 CONFIG_VT=y
 CONFIG_VT_CONSOLE=y
+CONFIG_DUMMY_CONSOLE=y
 CONFIG_FRAMEBUFFER_CONSOLE=y
+CONFIG_FRAMEBUFFER_CONSOLE_DEFERRED_TAKEOVER=y
 CONFIG_SPI=y
 CONFIG_SPI_ROCKCHIP=y
 
