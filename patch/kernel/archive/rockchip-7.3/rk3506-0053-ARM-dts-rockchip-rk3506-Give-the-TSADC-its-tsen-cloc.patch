From 6ca663f3a3920f0d44e01e6ca4e814a251f05641 Mon Sep 17 00:00:00 2001
From: Bas Vermeulen <bas.vermeulen@blackstar.nl>
Date: Thu, 29 Oct 2026 01:17:39 +0100
Subject: [PATCH 53/61] ARM: dts: rockchip: rk3506: Give the TSADC its tsen
 clock

Signed-off-by: Bas Vermeulen <bas.vermeulen@blackstar.nl>

diff --git a/arch/arm/boot/dts/rockchip/rk3506.dtsi b/arch/arm/boot/dts/rockchip/rk3506.dtsi
index 7aae127ae..f61339f86 100644
--- a/arch/arm/boot/dts/rockchip/rk3506.dtsi
+++ b/arch/arm/boot/dts/rockchip/rk3506.dtsi
@@ -723,8 +723,8 @@ tsadc: tsadc@ff650000 {
 		compatible = "rockchip,rk3506-tsadc";
 		reg = <0xff650000 0x400>;
 		interrupts = <GIC_SPI 58 IRQ_TYPE_LEVEL_HIGH>;
-		clocks = <&cru CLK_TSADC>, <&cru PCLK_TSADC>;
-		clock-names = "tsadc", "apb_pclk";
+		clocks = <&cru CLK_TSADC>, <&cru PCLK_TSADC>, <&cru CLK_TSADC_TSEN>;
+		clock-names = "tsadc", "apb_pclk", "tsen";
 		assigned-clocks = <&cru CLK_TSADC>, <&cru CLK_TSADC_TSEN>;
 		assigned-clock-rates = <1000000>, <12000000>;
 		resets = <&cru SRST_P_TSADC>, <&cru SRST_TSADC>;
