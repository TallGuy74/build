From 16e44c1da3db0b4eae16d7281da458188ce83b6c Mon Sep 17 00:00:00 2001
From: Bas Vermeulen <bas.vermeulen@blackstar.nl>
Date: Thu, 29 Oct 2026 22:37:28 +0100
Subject: [PATCH 72/73] dt-bindings: display: panel: panel-mipi-dbi-spi: Add
 the Luckfox Lyra PLC LCD

The Luckfox Lyra PLC has a 1.9" 170x320 IPS glass on a Sitronix ST7789V
controller, wired to SPI with a D/C line and no read-back. The glass
carries no part number of its own, so name it after the board.

Signed-off-by: Bas Vermeulen <bas.vermeulen@blackstar.nl>

diff --git a/Documentation/devicetree/bindings/display/panel/panel-mipi-dbi-spi.yaml b/Documentation/devicetree/bindings/display/panel/panel-mipi-dbi-spi.yaml
index 6f0290c4e..7cb0961ed 100644
--- a/Documentation/devicetree/bindings/display/panel/panel-mipi-dbi-spi.yaml
+++ b/Documentation/devicetree/bindings/display/panel/panel-mipi-dbi-spi.yaml
@@ -72,6 +72,7 @@ properties:
   compatible:
     items:
       - enum:
+          - luckfox,lyra-plc-lcd
           - saef,sftc154b
           - sainsmart18
           - shineworld,lh133k
