From cc5f644d55a7d3f8f4b8567eb6a022a8231b543a Mon Sep 17 00:00:00 2001
From: Bas Vermeulen <bas.vermeulen@blackstar.nl>
Date: Thu, 29 Oct 2026 09:57:37 +0100
Subject: [PATCH 58/71] staging: fbtft: Enable a backlight referenced from the
 panel node

pwm-backlight keeps a backlight that is referenced by a phandle switched
off at probe until its display driver enables it. Nothing in fbtft did
so, hence a panel wired with a plain "backlight = <&bl>" as in the common
panel bindings came up with bl_power = 4 and brightness writes without
effect (the PWM never ran; on an inverted backlight the panel stays at
full brightness on the idle pin level).

Look the backlight up with devm_of_find_backlight(), hand it to the
framebuffer so the existing turn-on at the end of
fbtft_register_framebuffer() applies, and disable it again on removal.

fbtft already used "backlight" as an integer selecting its GPIO LED
backlight type. That value only matters together with led-gpios, so read
the integer only when that GPIO is present and treat the property as a
phandle otherwise.

Signed-off-by: Bas Vermeulen <bas.vermeulen@blackstar.nl>

diff --git a/drivers/staging/fbtft/fbtft-core.c b/drivers/staging/fbtft/fbtft-core.c
index 7925d974d..24a0f024e 100644
--- a/drivers/staging/fbtft/fbtft-core.c
+++ b/drivers/staging/fbtft/fbtft-core.c
@@ -826,6 +826,8 @@ int fbtft_unregister_framebuffer(struct fb_info *fb_info)
 
 	if (par->fbtftops.unregister_backlight)
 		par->fbtftops.unregister_backlight(par);
+	else if (fb_info->bl_dev)
+		backlight_disable(fb_info->bl_dev);
 	fbtft_sysfs_exit(par);
 	unregister_framebuffer(fb_info);
 
@@ -1103,7 +1105,14 @@ static struct fbtft_platform_data *fbtft_properties_read(struct device *dev)
 	pdata->display.height = fbtft_property_value(dev, "height");
 	pdata->display.regwidth = fbtft_property_value(dev, "regwidth");
 	pdata->display.buswidth = fbtft_property_value(dev, "buswidth");
-	pdata->display.backlight = fbtft_property_value(dev, "backlight");
+	/*
+	 * "backlight" is the legacy fbtft integer selecting the GPIO LED
+	 * backlight type; it only means something together with led-gpios.
+	 * Without that GPIO the property is a phandle to a backlight device
+	 * as in the common panel bindings (see fbtft_probe_common()).
+	 */
+	if (device_property_present(dev, "led-gpios"))
+		pdata->display.backlight = fbtft_property_value(dev, "backlight");
 	pdata->display.bpp = fbtft_property_value(dev, "bpp");
 	pdata->display.debug = fbtft_property_value(dev, "debug");
 	pdata->rotate = fbtft_property_value(dev, "rotate");
@@ -1166,6 +1175,22 @@ int fbtft_probe_common(struct fbtft_display *display,
 	par->spi = sdev;
 	par->pdev = pdev;
 
+	/*
+	 * A backlight referenced from the panel node belongs to this display:
+	 * drivers like pwm-backlight leave a backlight that is referenced by a
+	 * phandle switched off until its display driver enables it.
+	 */
+	if (!display->backlight) {
+		struct backlight_device *bl = devm_of_find_backlight(dev);
+
+		if (IS_ERR(bl)) {
+			ret = dev_err_probe(dev, PTR_ERR(bl),
+					    "failed to get backlight\n");
+			goto out_release;
+		}
+		info->bl_dev = bl;
+	}
+
 	if (display->buswidth == 0) {
 		ret = dev_err_probe(dev, -EINVAL, "buswidth is not set\n");
 		goto out_release;
