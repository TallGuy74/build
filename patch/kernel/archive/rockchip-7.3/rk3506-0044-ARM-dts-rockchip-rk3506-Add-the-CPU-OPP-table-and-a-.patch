From bf520ae5cde39fc9df0ef6d80dd1d5b7d47e6c53 Mon Sep 17 00:00:00 2001
From: Bas Vermeulen <bas.vermeulen@blackstar.nl>
Date: Wed, 28 Oct 2026 23:50:58 +0100
Subject: [PATCH 44/61] ARM: dts: rockchip: rk3506: Add the CPU OPP table and a
 thermal zone

Operating points from the vendor tree (850 mV up to 1.2 GHz, 975 mV at
1.512 GHz); the lowest point is 589.824 MHz because that is the rate the
armclk table provides where the vendor has 600 MHz. The CPUs get cooling
cells and a cpu-thermal zone on TSADC channel 0 throttles them at 70 and
85 degrees, with a critical trip at 115 degrees (the hardware shutdown is
set to 120).

Signed-off-by: Bas Vermeulen <bas.vermeulen@blackstar.nl>

diff --git a/arch/arm/boot/dts/rockchip/rk3506.dtsi b/arch/arm/boot/dts/rockchip/rk3506.dtsi
index ae0151fdb..79e171f7e 100644
--- a/arch/arm/boot/dts/rockchip/rk3506.dtsi
+++ b/arch/arm/boot/dts/rockchip/rk3506.dtsi
@@ -18,6 +18,7 @@
 #include <dt-bindings/reset/rockchip,rk3506-cru.h>
 #include <dt-bindings/gpio/gpio.h>
 #include <dt-bindings/interrupt-controller/irq.h>
+#include <dt-bindings/thermal/thermal.h>
 #include <dt-bindings/interrupt-controller/arm-gic.h>
 #include <dt-bindings/pinctrl/rockchip.h>
 
@@ -49,6 +50,8 @@ cpu0: cpu@f00 {
 			reg = <0xf00>;
 			enable-method = "psci";
 			clocks = <&cru ARMCLK>;
+			operating-points-v2 = <&cpu0_opp_table>;
+			#cooling-cells = <2>;
 		};
 
 		cpu1: cpu@f01 {
@@ -57,6 +60,8 @@ cpu1: cpu@f01 {
 			reg = <0xf01>;
 			enable-method = "psci";
 			clocks = <&cru ARMCLK>;
+			operating-points-v2 = <&cpu0_opp_table>;
+			#cooling-cells = <2>;
 		};
 
 		cpu2: cpu@f02 {
@@ -65,6 +70,53 @@ cpu2: cpu@f02 {
 			reg = <0xf02>;
 			enable-method = "psci";
 			clocks = <&cru ARMCLK>;
+			operating-points-v2 = <&cpu0_opp_table>;
+			#cooling-cells = <2>;
+		};
+	};
+
+	/*
+	 * Frequencies as the armclk rate table knows them (the lowest vendor
+	 * point, 600 MHz, is 589.824 MHz there). Voltages from the vendor tree.
+	 */
+	cpu0_opp_table: opp-table-cpu {
+		compatible = "operating-points-v2";
+		opp-shared;
+
+		opp-589824000 {
+			opp-hz = /bits/ 64 <589824000>;
+			opp-microvolt = <850000 850000 1207000>;
+			clock-latency-ns = <40000>;
+		};
+		opp-800000000 {
+			opp-hz = /bits/ 64 <800000000>;
+			opp-microvolt = <850000 850000 1207000>;
+			clock-latency-ns = <40000>;
+		};
+		opp-1008000000 {
+			opp-hz = /bits/ 64 <1008000000>;
+			opp-microvolt = <850000 850000 1207000>;
+			clock-latency-ns = <40000>;
+		};
+		opp-1200000000 {
+			opp-hz = /bits/ 64 <1200000000>;
+			opp-microvolt = <850000 850000 1207000>;
+			clock-latency-ns = <40000>;
+		};
+		opp-1296000000 {
+			opp-hz = /bits/ 64 <1296000000>;
+			opp-microvolt = <900000 900000 1207000>;
+			clock-latency-ns = <40000>;
+		};
+		opp-1416000000 {
+			opp-hz = /bits/ 64 <1416000000>;
+			opp-microvolt = <937500 937500 1207000>;
+			clock-latency-ns = <40000>;
+		};
+		opp-1512000000 {
+			opp-hz = /bits/ 64 <1512000000>;
+			opp-microvolt = <975000 975000 1207000>;
+			clock-latency-ns = <40000>;
 		};
 	};
 
@@ -73,6 +125,47 @@ psci {
 		method = "smc";
 	};
 
+	thermal-zones {
+		cpu_thermal: cpu-thermal {
+			polling-delay-passive = <100>;
+			polling-delay = <1000>;
+			thermal-sensors = <&tsadc 0>;
+
+			trips {
+				cpu_alert0: cpu-alert0 {
+					temperature = <70000>;
+					hysteresis = <2000>;
+					type = "passive";
+				};
+				cpu_alert1: cpu-alert1 {
+					temperature = <85000>;
+					hysteresis = <2000>;
+					type = "passive";
+				};
+				cpu_crit: cpu-crit {
+					temperature = <115000>;
+					hysteresis = <2000>;
+					type = "critical";
+				};
+			};
+
+			cooling-maps {
+				map0 {
+					trip = <&cpu_alert0>;
+					cooling-device = <&cpu0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
+							 <&cpu1 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
+							 <&cpu2 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
+				};
+				map1 {
+					trip = <&cpu_alert1>;
+					cooling-device = <&cpu0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
+							 <&cpu1 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
+							 <&cpu2 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
+				};
+			};
+		};
+	};
+
 	reserved-memory {
 		#address-cells = <1>;
 		#size-cells = <1>;
