From 1a3f572bcc478248e6ff6582285e9dd7a96359db Mon Sep 17 00:00:00 2001
From: Bas Vermeulen <bas.vermeulen@blackstar.nl>
Date: Wed, 28 Oct 2026 17:24:21 +0100
Subject: [PATCH 33/56] ARM: dts: rockchip: rk3506: Add the PWM controllers

pwm0 (four channels at 0xff930000, PMU domain) and pwm1 (eight channels
at 0xff170000), one node per channel as the PWMv4 binding wants, all
disabled; each takes its pwm, pclk, osc and rc clocks from the CRU.

Signed-off-by: Bas Vermeulen <bas.vermeulen@blackstar.nl>

diff --git a/arch/arm/boot/dts/rockchip/rk3506.dtsi b/arch/arm/boot/dts/rockchip/rk3506.dtsi
index eb20f37a7..ae0151fdb 100644
--- a/arch/arm/boot/dts/rockchip/rk3506.dtsi
+++ b/arch/arm/boot/dts/rockchip/rk3506.dtsi
@@ -348,6 +348,94 @@ spi0: spi@ff120000 {
 		status = "disabled";
 	};
 
+	pwm1_8ch_0: pwm@ff170000 {
+		compatible = "rockchip,rk3506-pwm", "rockchip,rk3576-pwm";
+		reg = <0xff170000 0x1000>;
+		clocks = <&cru CLK_PWM1>, <&cru PCLK_PWM1>, <&cru CLK_OSC_PWM1>,
+			 <&cru CLK_RC_PWM1>;
+		clock-names = "pwm", "pclk", "osc", "rc";
+		interrupts = <GIC_SPI 26 IRQ_TYPE_LEVEL_HIGH>;
+		#pwm-cells = <3>;
+		status = "disabled";
+	};
+
