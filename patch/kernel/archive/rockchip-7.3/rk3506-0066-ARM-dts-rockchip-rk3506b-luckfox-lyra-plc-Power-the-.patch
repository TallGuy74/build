From 17543706038c5e53223685ea94bdc9bedb202398 Mon Sep 17 00:00:00 2001
From: Bas Vermeulen <bas.vermeulen@blackstar.nl>
Date: Thu, 29 Oct 2026 12:09:46 +0100
Subject: [PATCH 66/66] ARM: dts: rockchip: rk3506b-luckfox-lyra-plc: Power the
 Wi-Fi module from early boot

The AIC8800 module only gets power when rfkill-gpio probes, which on
this kernel is within a few hundred milliseconds of the USB hub
applying port power. The module then attaches to the hub while its own
boot is still running and fails the first descriptor read (-71), which
the hub retries successfully. The vendor kernel powers the module four
seconds later and never sees this.

Drive the power pin high with a pinctrl hog from early boot so that
the module is ready long before the hub probes its port; rfkill-gpio
takes the line as it is (GPIOD_ASIS), so the software kill switch keeps
working and nothing glitches at probe.

Signed-off-by: Bas Vermeulen <bas.vermeulen@blackstar.nl>

diff --git a/arch/arm/boot/dts/rockchip/rk3506b-luckfox-lyra-plc.dts b/arch/arm/boot/dts/rockchip/rk3506b-luckfox-lyra-plc.dts
index 6e2334af6..520c82315 100644
--- a/arch/arm/boot/dts/rockchip/rk3506b-luckfox-lyra-plc.dts
+++ b/arch/arm/boot/dts/rockchip/rk3506b-luckfox-lyra-plc.dts
@@ -51,7 +51,10 @@ button-user {
 	 * GPIO1_C5 is the power enable of the AIC8800DC Wi-Fi/BT module (the
 	 * vendor tree calls it BT,power_gpio and lets rfkill raise it; the chip
 	 * only shows up on the USB hub once it is high). The module carries
-	 * both radios, so this one switch cuts Bluetooth too.
+	 * both radios, so this one switch cuts Bluetooth too. The pin is driven
+	 * high by a pinctrl hog from early boot (see &pinctrl): powered only
+	 * when rfkill probes, the module attached to the hub while still
+	 * booting and failed its first descriptor read.
 	 */
 	rfkill-wlan {
 		compatible = "rfkill-gpio";
@@ -347,3 +350,17 @@ &wdt0 {
 	status = "okay";
 };
 
+&pinctrl {
+	pinctrl-names = "default";
+	pinctrl-0 = <&wifi_pwr_hog>;
+
+	pcfg_output_high: pcfg-output-high {
+		output-high;
+	};
+
+	wifi {
+		wifi_pwr_hog: wifi-pwr-hog {
+			rockchip,pins = <1 RK_PC5 RK_FUNC_GPIO &pcfg_output_high>;
+		};
+	};
+};
