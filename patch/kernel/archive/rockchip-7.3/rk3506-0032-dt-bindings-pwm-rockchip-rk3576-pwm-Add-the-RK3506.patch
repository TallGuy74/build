From f04ed8c376384a9d29393c9d7cea89b93b3b6262 Mon Sep 17 00:00:00 2001
From: Bas Vermeulen <bas.vermeulen@blackstar.nl>
Date: Wed, 28 Oct 2026 17:24:20 +0100
Subject: [PATCH 32/38] dt-bindings: pwm: rockchip,rk3576-pwm: Add the RK3506

The RK3506 carries the same PWMv4 blocks (one with four channels in the
PMU domain, one with eight) and the vendor tree already describes them
as "rockchip,rk3506-pwm" falling back to "rockchip,rk3576-pwm".

Signed-off-by: Bas Vermeulen <bas.vermeulen@blackstar.nl>

diff --git a/Documentation/devicetree/bindings/pwm/rockchip,rk3576-pwm.yaml b/Documentation/devicetree/bindings/pwm/rockchip,rk3576-pwm.yaml
index 48d5055c8..72d3b7dbc 100644
--- a/Documentation/devicetree/bindings/pwm/rockchip,rk3576-pwm.yaml
+++ b/Documentation/devicetree/bindings/pwm/rockchip,rk3576-pwm.yaml
@@ -20,8 +20,12 @@ allOf:
 
 properties:
   compatible:
-    items:
+    oneOf:
       - const: rockchip,rk3576-pwm
+      - items:
+          - enum:
+              - rockchip,rk3506-pwm
+          - const: rockchip,rk3576-pwm
 
   reg:
     maxItems: 1
