From b7f83c11f696519e187b09b36504d627f95af700 Mon Sep 17 00:00:00 2001
From: Bas Vermeulen <bas.vermeulen@blackstar.nl>
Date: Wed, 28 Oct 2026 23:50:57 +0100
Subject: [PATCH 42/68] net: stmmac: dwmac-rk: Keep an external PHY's reference
 clock running

The PHY node's clock was only taken for the integrated PHY. Boards whose
external RMII PHY gets its reference from the SoC (RK3506: the 25 MHz
CLK_MAC_OUT) describe that clock on the PHY node too; nobody held it, so
clk_disable_unused gated it and the link never came up without
clk_ignore_unused. Take the PHY clock whenever the node has one, enable
it with the other GMAC clocks, and only force the 50 MHz rate for the
integrated PHY.

Signed-off-by: Bas Vermeulen <bas.vermeulen@blackstar.nl>

diff --git a/drivers/net/ethernet/stmicro/stmmac/dwmac-rk.c b/drivers/net/ethernet/stmicro/stmmac/dwmac-rk.c
index 72bdbcb5e..d2946884e 100644
--- a/drivers/net/ethernet/stmicro/stmmac/dwmac-rk.c
+++ b/drivers/net/ethernet/stmicro/stmmac/dwmac-rk.c
@@ -1139,12 +1139,23 @@ static int rk_gmac_clk_init(struct plat_stmmacenet_data *plat)
 		clk_set_rate(plat->stmmac_clk, 50000000);
 	}
 
-	if (plat->phy_node && bsp_priv->integrated_phy) {
+	if (plat->phy_node) {
+		/*
+		 * The integrated PHY needs its 50 MHz clock; an external PHY
+		 * may describe a reference clock it gets from the SoC
+		 * (e.g. the 25 MHz CLK_MAC_OUT of RK3506 boards), which has
+		 * to stay running at the rate the device tree assigned.
+		 */
 		bsp_priv->clk_phy = of_clk_get(plat->phy_node, 0);
-		ret = PTR_ERR_OR_ZERO(bsp_priv->clk_phy);
-		if (ret)
-			return dev_err_probe(dev, ret, "Cannot get PHY clock\n");
-		clk_set_rate(bsp_priv->clk_phy, 50000000);
+		if (IS_ERR(bsp_priv->clk_phy)) {
+			ret = PTR_ERR(bsp_priv->clk_phy);
+			bsp_priv->clk_phy = NULL;
+			if (bsp_priv->integrated_phy)
+				return dev_err_probe(dev, ret,
+						     "Cannot get PHY clock\n");
+		} else if (bsp_priv->integrated_phy) {
+			clk_set_rate(bsp_priv->clk_phy, 50000000);
+		}
 	}
 
 	return 0;
