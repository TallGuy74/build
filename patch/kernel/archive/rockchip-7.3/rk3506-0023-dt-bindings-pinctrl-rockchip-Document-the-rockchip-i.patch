From 2319038068d7d3f06e5617de172a6236c96771ab Mon Sep 17 00:00:00 2001
From: Bas Vermeulen <bas.vermeulen@blackstar.nl>
Date: Wed, 28 Oct 2026 17:04:24 +0100
Subject: [PATCH 23/38] dt-bindings: pinctrl: rockchip: Document the
 rockchip,ioc1 phandle

pinctrl-rockchip.c looks up an optional "rockchip,ioc1" syscon next to
"rockchip,pmu" and "rockchip,rmio", but the binding never gained the
property, so every rk3506 device tree that sets it fails dtbs_check.
Describe it.

Signed-off-by: Bas Vermeulen <bas.vermeulen@blackstar.nl>

diff --git a/Documentation/devicetree/bindings/pinctrl/rockchip,pinctrl.yaml b/Documentation/devicetree/bindings/pinctrl/rockchip,pinctrl.yaml
index 4194a04e9..fbbacb07f 100644
--- a/Documentation/devicetree/bindings/pinctrl/rockchip,pinctrl.yaml
+++ b/Documentation/devicetree/bindings/pinctrl/rockchip,pinctrl.yaml
@@ -76,6 +76,13 @@ properties:
       some SoCs (e.g. rk3506) to configure the secondary block-level
       pinmux functions.
 
+  rockchip,ioc1:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description:
+      The phandle of the syscon node for the second IOC register block,
+      which on the rk3506 holds the iomux and pin configuration of the
+      GPIO banks that are not covered by the GRF.
+
   "#address-cells":
     enum: [1, 2]
 
