From 3dcd1e7f421d443a1303ff5a531e0a9ea73afb42 Mon Sep 17 00:00:00 2001
From: Bas Vermeulen <bas.vermeulen@blackstar.nl>
Date: Thu, 29 Oct 2026 00:02:47 +0100
Subject: [PATCH 47/73] dt-bindings: net: can: Add the Rockchip RK3576-type CAN
 controller

Classic CAN controller of the RK3576, RK3506 and RV1126B, with two
clocks (bit-rate and APB), two resets, an optional RX DMA channel and
two vendor tunables (automatic retransmission limit, RX SRAM slot size).

Signed-off-by: Bas Vermeulen <bas.vermeulen@blackstar.nl>

diff --git a/Documentation/devicetree/bindings/net/can/rockchip,rk3576-can.yaml b/Documentation/devicetree/bindings/net/can/rockchip,rk3576-can.yaml
new file mode 100644
index 000000000..67caace03
--- /dev/null
+++ b/Documentation/devicetree/bindings/net/can/rockchip,rk3576-can.yaml
@@ -0,0 +1,97 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/net/can/rockchip,rk3576-can.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Rockchip RK3576-type CAN controller
+
+maintainers:
+  - Bas Vermeulen <bas.vermeulen@blackstar.nl>
+
+description:
+  Classic CAN controller found on the Rockchip RK3576, RK3506 and RV1126B
+  SoCs, with an internal receive SRAM and an optional DMA drain of it.
+
+allOf:
+  - $ref: can-controller.yaml#
+
+properties:
+  compatible:
+    oneOf:
+      - const: rockchip,rk3576-can
+      - items:
+          - enum:
+              - rockchip,rk3506-can
+              - rockchip,rv1126b-can
+          - const: rockchip,rk3576-can
+
+  reg:
+    maxItems: 1
+
+  interrupts:
+    maxItems: 1
+
+  clocks:
+    items:
+      - description: bit-rate (functional) clock
+      - description: APB bus clock
+
+  clock-names:
+    items:
+      - const: baudclk
+      - const: apb_pclk
+
+  resets:
+    items:
+      - description: controller reset
+      - description: APB bus reset
+
+  reset-names:
+    items:
+      - const: can
+      - const: can-apb
+
+  dmas:
+    maxItems: 1
+
+  dma-names:
+    const: rx
+
+  rockchip,auto-retx-cnt:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    description: automatic retransmission limit (0 = unlimited)
+    maximum: 65535
+
+  rockchip,rx-max-data:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    description: receive SRAM slot size in words
+    enum: [4, 18]
+
+required:
+  - compatible
+  - reg
+  - interrupts
+  - clocks
+  - clock-names
+  - resets
+  - reset-names
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/interrupt-controller/arm-gic.h>
+    #include <dt-bindings/interrupt-controller/irq.h>
+    #include <dt-bindings/clock/rockchip,rk3506-cru.h>
+    #include <dt-bindings/reset/rockchip,rk3506-cru.h>
+
+    can@ff320000 {
+        compatible = "rockchip,rk3506-can", "rockchip,rk3576-can";
+        reg = <0xff320000 0x1000>;
+        interrupts = <GIC_SPI 45 IRQ_TYPE_LEVEL_HIGH>;
+        clocks = <&cru CLK_CAN0>, <&cru HCLK_CAN0>;
+        clock-names = "baudclk", "apb_pclk";
+        resets = <&cru SRST_CAN0>, <&cru SRST_H_CAN0>;
+        reset-names = "can", "can-apb";
+    };
