From 25012228b454fa18f8a1e2e36f34f596b72aa219 Mon Sep 17 00:00:00 2001
From: Bas Vermeulen <bas.vermeulen@blackstar.nl>
Date: Thu, 29 Oct 2026 01:42:49 +0100
Subject: [PATCH 55/74] ARM: dts: rockchip: rk3506: OPPs reachable without
 re-rating a PLL

Pin v1pll to 1.2 GHz from the CRU node (nothing else uses it) and keep
only the operating points the armclk divider table reaches from the
fixed PLLs: 400 and 1200 MHz from v1pll, 750 MHz from gpll, all at the
vendor's 850 mV.

Signed-off-by: Bas Vermeulen <bas.vermeulen@blackstar.nl>

diff --git a/arch/arm/boot/dts/rockchip/rk3506.dtsi b/arch/arm/boot/dts/rockchip/rk3506.dtsi
index f61339f86..202f293bc 100644
--- a/arch/arm/boot/dts/rockchip/rk3506.dtsi
+++ b/arch/arm/boot/dts/rockchip/rk3506.dtsi
@@ -76,25 +76,22 @@ cpu2: cpu@f02 {
 	};
 
 	/*
-	 * Frequencies as the armclk rate table knows them (the lowest vendor
-	 * point, 600 MHz, is 589.824 MHz there). Voltages from the vendor tree.
+	 * cpufreq muxes the cores between the PLLs at fixed rates, so the
+	 * points are what gpll (1.5 GHz) and v1pll (pinned to 1.2 GHz by the
+	 * CRU node) divide to and the armclk table knows. 850 mV covers all of
+	 * them in the vendor tree.
 	 */
 	cpu0_opp_table: opp-table-cpu {
 		compatible = "operating-points-v2";
 		opp-shared;
 
-		opp-589824000 {
-			opp-hz = /bits/ 64 <589824000>;
+		opp-400000000 {
+			opp-hz = /bits/ 64 <400000000>;
 			opp-microvolt = <850000 850000 1207000>;
 			clock-latency-ns = <40000>;
 		};
-		opp-800000000 {
-			opp-hz = /bits/ 64 <800000000>;
-			opp-microvolt = <850000 850000 1207000>;
-			clock-latency-ns = <40000>;
-		};
-		opp-1008000000 {
-			opp-hz = /bits/ 64 <1008000000>;
+		opp-750000000 {
+			opp-hz = /bits/ 64 <750000000>;
 			opp-microvolt = <850000 850000 1207000>;
 			clock-latency-ns = <40000>;
 		};
@@ -103,21 +100,6 @@ opp-1200000000 {
 			opp-microvolt = <850000 850000 1207000>;
 			clock-latency-ns = <40000>;
 		};
-		opp-1296000000 {
-			opp-hz = /bits/ 64 <1296000000>;
-			opp-microvolt = <900000 900000 1207000>;
-			clock-latency-ns = <40000>;
-		};
-		opp-1416000000 {
-			opp-hz = /bits/ 64 <1416000000>;
-			opp-microvolt = <937500 937500 1207000>;
-			clock-latency-ns = <40000>;
-		};
-		opp-1512000000 {
-			opp-hz = /bits/ 64 <1512000000>;
-			opp-microvolt = <975000 975000 1207000>;
-			clock-latency-ns = <40000>;
-		};
 	};
 
 	psci {
@@ -829,10 +811,12 @@ cru: clock-controller@ff9a0000 {
 		 */
 		assigned-clocks =
 			<&cru CLK_FRAC_UART_MATRIX0>,
-			<&cru CLK_FRAC_UART_MATRIX1>;
+			<&cru CLK_FRAC_UART_MATRIX1>,
+			<&cru PLL_V1PLL>;
 		assigned-clock-rates =
 			<96000000>,
-			<128000000>;
+			<128000000>,
+			<1200000000>;
 	};
 
 	pinctrl: pinctrl {
