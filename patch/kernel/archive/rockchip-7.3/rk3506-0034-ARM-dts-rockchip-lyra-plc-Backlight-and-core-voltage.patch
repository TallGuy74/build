From beec9100953d9524abe1138f28b79838023062b4 Mon Sep 17 00:00:00 2001
From: Bas Vermeulen <bas.vermeulen@blackstar.nl>
Date: Wed, 28 Oct 2026 17:24:21 +0100
Subject: [PATCH 34/74] ARM: dts: rockchip: lyra-plc: Backlight and
 core-voltage PWMs

The panel backlight is pwm0 channel 2 on RM_IO5 (25 us period,
inverted); the CPU core voltage is a PWM-driven buck on pwm0 channel 0 /
RM_IO21 (5 us, inverted, 0.71 to 1.207 V). Describe the regulator as
always-on without a cpu-supply consumer so Linux keeps the PWM running
but leaves the voltage where U-Boot put it until an OPP table is added.

Signed-off-by: Bas Vermeulen <bas.vermeulen@blackstar.nl>

diff --git a/arch/arm/boot/dts/rockchip/rk3506b-luckfox-lyra-plc.dts b/arch/arm/boot/dts/rockchip/rk3506b-luckfox-lyra-plc.dts
index df4a620f5..44addef36 100644
--- a/arch/arm/boot/dts/rockchip/rk3506b-luckfox-lyra-plc.dts
+++ b/arch/arm/boot/dts/rockchip/rk3506b-luckfox-lyra-plc.dts
@@ -11,6 +11,7 @@
 #include <dt-bindings/interrupt-controller/irq.h>
 #include <dt-bindings/leds/common.h>
 #include <dt-bindings/pinctrl/rockchip.h>
+#include <dt-bindings/pwm/pwm.h>
 #include "rk3506.dtsi"
 
 / {
@@ -48,8 +49,10 @@ button-user {
 
 	backlight: backlight {
 		compatible = "pwm-backlight";
-		/* pwm0 channel 2 on RM_IO5; no PWM driver upstream yet for this block */
-		status = "disabled";
+		pwms = <&pwm0_4ch_2 0 25000 PWM_POLARITY_INVERTED>;
+		brightness-levels = <0 20 40 60 80 100 120 140 160 180 200 220 240 255>;
+		default-brightness-level = <10>;
+		power-supply = <&vcc_3v3>;
 	};
 
 	leds {
@@ -91,6 +94,23 @@ vcc_1v8: regulator-vcc-1v8 {
 		regulator-max-microvolt = <1800000>;
 		vin-supply = <&vcc_3v3>;
 	};
+
+	/*
+	 * The core voltage is a PWM-driven buck: pwm0 channel 0 on RM_IO21,
+	 * 5 us period, inverted. U-Boot sets it up; Linux keeps the PWM
+	 * running and leaves the voltage alone until an OPP table asks for
+	 * more.
+	 */
+	vdd_cpu: regulator-vdd-cpu {
+		compatible = "pwm-regulator";
+		pwms = <&pwm0_4ch_0 0 5000 PWM_POLARITY_INVERTED>;
+		regulator-name = "vdd_cpu";
+		regulator-always-on;
+		regulator-boot-on;
+		regulator-min-microvolt = <710000>;
+		regulator-max-microvolt = <1207000>;
+		vin-supply = <&vcc_sys>;
+	};
 };
 
 &gmac0 {
@@ -179,6 +199,18 @@ humidity-sensor@70 {
 	};
 };
 
+&pwm0_4ch_0 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&rm_io21_pwm0_ch0>;
+	status = "okay";
+};
+
+&pwm0_4ch_2 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&rm_io5_pwm0_ch2>;
+	status = "okay";
+};
+
 &saradc {
 	vref-supply = <&vcc_1v8>;
 	status = "okay";
