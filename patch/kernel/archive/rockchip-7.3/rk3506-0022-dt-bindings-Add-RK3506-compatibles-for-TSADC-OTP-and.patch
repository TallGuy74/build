From 9f9ab1d1a5a685ae0a0d45632c8c392b05ba269d Mon Sep 17 00:00:00 2001
From: Bas Vermeulen <bas.vermeulen@blackstar.nl>
Date: Wed, 28 Oct 2026 17:04:24 +0100
Subject: [PATCH 22/38] dt-bindings: Add RK3506 compatibles for TSADC, OTP and
 USB2 PHY, and the Luckfox Lyra PLC board

rockchip,rk3506-tsadc, rockchip,rk3506-otp (same clock set as rk3528) and
rockchip,rk3506-usb2phy (two ports; needs rockchip,usbgrf and two clocks
like rk3528), plus the luckfox,lyra-plc board compatible.

Also list the RK3506 GRF, PMU GRF and the three IOC register blocks in
the Rockchip syscon binding, let "rockchip,rk3506-tsadc" carry the
rockchip,grf phandle its initialisation needs, and add the Luckfox Lyra
Plus board next to the Lyra PLC.

Signed-off-by: Bas Vermeulen <bas.vermeulen@blackstar.nl>

diff --git a/Documentation/devicetree/bindings/arm/rockchip.yaml b/Documentation/devicetree/bindings/arm/rockchip.yaml
index a799bb843..13948c03f 100644
--- a/Documentation/devicetree/bindings/arm/rockchip.yaml
+++ b/Documentation/devicetree/bindings/arm/rockchip.yaml
@@ -837,6 +837,16 @@ properties:
           - const: luckfox,core3576
           - const: rockchip,rk3576
 
+      - description: Luckfox Lyra PLC
+        items:
+          - const: luckfox,lyra-plc
+          - const: rockchip,rk3506
+
+      - description: Luckfox Lyra Plus
+        items:
+          - const: luckfox,lyra-plus
+          - const: rockchip,rk3506
+
       - description: Lunzn FastRhino R66S / R68S
         items:
           - enum:
