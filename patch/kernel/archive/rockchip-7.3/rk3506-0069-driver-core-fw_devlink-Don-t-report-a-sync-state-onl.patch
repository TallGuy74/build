From a6e0bf4931a82cb40d82e0974e8ae73976b473b9 Mon Sep 17 00:00:00 2001
From: Bas Vermeulen <bas.vermeulen@blackstar.nl>
Date: Thu, 29 Oct 2026 13:23:10 +0100
Subject: [PATCH 69/73] driver core: fw_devlink: Don't report a sync-state-only
 link to a probed consumer

fw_devlink_create_devlink() reports an error when device_link_add()
refuses a link, but device_link_add() refuses a SYNC_STATE_ONLY link
by design once the consumer has probed. That happens whenever a child
node of a probed device becomes a device of its own only later: a USB
device behind an onboard hub, whose node names a supply, makes the hub's
platform device print

  Failed to create device link (0x180) with supplier regulator-wifi for
  /usb@ff780000/hub@1/wifi@1

on every boot although the supply is found and handled by the device
that eventually owns the node. Skip the attempt in that case instead of
reporting it.

Signed-off-by: Bas Vermeulen <bas.vermeulen@blackstar.nl>

diff --git a/drivers/base/core.c b/drivers/base/core.c
index 4c0c37399..00628b6d1 100644
--- a/drivers/base/core.c
+++ b/drivers/base/core.c
@@ -2240,6 +2240,18 @@ static int fw_devlink_create_devlink(struct device *con,
 			goto out;
 		}
 
+		/*
+		 * A SYNC_STATE_ONLY link is of no use once the consumer has
+		 * probed and device_link_add() refuses to create one then;
+		 * that is the normal outcome for a child node that becomes a
+		 * device of its own only after its parent probed (a USB device
+		 * behind an onboard hub, for example), not an error.
+		 */
+		if (flags & DL_FLAG_SYNC_STATE_ONLY &&
+		    con->links.status != DL_DEV_NO_DRIVER &&
+		    con->links.status != DL_DEV_PROBING)
+			goto out;
+
 		if (con != sup_dev && !device_link_add(con, sup_dev, flags)) {
 			dev_err(con, "Failed to create device link (0x%x) with supplier %s for %pfwf\n",
 				flags, dev_name(sup_dev), link->consumer);
