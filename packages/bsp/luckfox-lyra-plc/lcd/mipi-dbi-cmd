#!/bin/bash
# Compile a panel-mipi-dbi init sequence from the mipi-dbi-cmd text format
# ("command <cmd> [<param>...]" and "delay <ms>", '#' comments) to the
# firmware file the driver loads: the 15-byte magic, format version 1, then
# <cmd> <count> <params...> per command, a delay being NOP (0x00) with one
# parameter.
set -euo pipefail

[[ $# -eq 2 ]] || { echo "usage: $0 <in.txt> <out.bin>" >&2; exit 2; }
bytes=(0x4d 0x49 0x50 0x49 0x20 0x44 0x42 0x49 0 0 0 0 0 0 0 1)
while read -r line; do
	line=${line%%#*}
	read -r -a w <<<"$line"
	[[ ${#w[@]} -gt 0 ]] || continue
	case ${w[0]} in
	command)
		[[ ${#w[@]} -ge 2 ]] || { echo "$1: command without a value" >&2; exit 1; }
		bytes+=("${w[1]}" $((${#w[@]} - 2)) "${w[@]:2}") ;;
	delay)
		(( w[1] >= 0 && w[1] <= 255 )) || { echo "$1: delay ${w[1]} out of range" >&2; exit 1; }
		bytes+=(0 1 "${w[1]}") ;;
	*)
		echo "$1: unknown keyword '${w[0]}'" >&2; exit 1 ;;
	esac
done <"$1"
out=""
for b in "${bytes[@]}"; do
	(( b >= 0 && b <= 255 )) || { echo "$1: byte $b out of range" >&2; exit 1; }
	out+=$(printf '\\x%02x' "$((b))")
done
printf "$out" >"$2"
